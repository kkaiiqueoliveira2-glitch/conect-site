{
  "name": "conect-site",
  "version": "1.0.0",
  "private": true,
  "description": "Site da Conect+ — pagina estatica unica + funcao serverless de lead",
  "scripts": {
    "dev": "node preview.js",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headers": "playwright test --config playwright.headers.config.js tests/headers.spec.js",
    "budget": "node scripts/budget.js",
    "segredos": "node scripts/varredura-segredos.js",
    "verificar": "npm run segredos && npm run budget && npm run test"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0"
  },
  "engines": {
    "node": ">=20"
  }
}
